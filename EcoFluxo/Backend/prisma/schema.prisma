generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id       Int      @id @default(autoincrement())
  nome     String
  email    String   @unique
  senha    String
  perfil   Perfil   @default(MORADOR)
  criadoEm DateTime @default(now())

  @@map("usuarios")
}
model Ecoponto{
   id			Int        @id @default(autoincrement())
   nome			String
   Latitude		String
   Longitude	String
   descricao	String?
   cep        String?
   logradouro String?
   numero     String?
   bairro     String?
   cidade     String?
   uf         String?
   criadoEm     DateTime      @default(now())
   lixeiras  Lixeira[]
   @@map("ecopontos")
}
model Lixeira {
  id           Int           @id @default(autoincrement())
  uuid_sensor  String
  tipo         Tipo
  volume_max   Int
  nivel_cheio  Int
  ecoponto_id  Int
  criadoEm     DateTime      @default(now())
  notificacoes Notificacao[]
  ecoponto     Ecoponto @relation(fields: [ecoponto_id], references: [id], onDelete: Cascade)
  
  
  @@map("lixeiras")
}

model Notificacao {
  id         Int      @id @default(autoincrement())
  lixeira_id Int
  mensagem   String
  lida       Boolean
  criadoEm   DateTime @default(now())
  lixeira    Lixeira  @relation(fields: [lixeira_id], references: [id], onDelete: Cascade)

  @@index([lixeira_id], map: "notificacoes_lixeira_id_fkey")
  @@map("notificacoes")
}

enum Perfil {
  MORADOR
  GESTOR
}

enum Tipo {
  Plastico
  Vidro
  Papel
  Metal
  Organico
}
